---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
---
<BaseLayout title="blog — Bishesh Thapa" description="Notes on engineering, tooling, and building things.">
  <h1 class="mb-8 text-xl font-semibold lowercase">blog</h1>
  {posts.length === 0 ? (
    <p class="text-sm text-fg-muted">no posts yet — check back soon.</p>
  ) : (
    <div class="space-y-1">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`}
           class="group block -mx-2 rounded-md px-2 py-3 hover:bg-bg-subtle transition-colors">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-medium text-fg group-hover:text-accent-fg transition-colors">{post.data.title}</span>
            <span class="shrink-0 text-xs text-fg-muted">{fmt(post.data.date)}</span>
          </div>
          <p class="mt-1 text-sm text-fg-muted">{post.data.description}</p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
