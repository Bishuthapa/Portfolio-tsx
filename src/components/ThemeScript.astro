---
// Runs before paint — resolves theme from localStorage or system pref so there
// is NO dark-mode flash (the #1 thing that makes clones look worse than source).
---
<script is:inline>
  (function () {
    function resolveTheme() {
      try {
        const stored = localStorage.getItem('theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        return stored === 'light' || stored === 'dark' ? stored : system;
      } catch (_) {
        return 'dark';
      }
    }
    function applyTheme(doc) {
      doc.documentElement.dataset.theme = resolveTheme();
    }
    applyTheme(document);
    document.addEventListener('astro:before-swap', (event) => {
      applyTheme(event.newDocument);
    });
    document.addEventListener('astro:after-swap', () => {
      applyTheme(document);
    });
  })();
</script>
