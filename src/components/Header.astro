---
import LogoLink from './LogoLink.astro';
import { NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="mb-12 flex items-center justify-between gap-4">
  <LogoLink />
  <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Primary">
    {NAV.map((item) => (
      <a
        href={item.href}
        class:list={[
          'transition-colors hover:text-fg',
          isActive(item.href) ? 'text-fg' : 'text-fg-muted',
        ]}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </nav>
</header>
