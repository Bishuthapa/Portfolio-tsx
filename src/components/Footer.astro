---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-border pt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between text-xs text-fg-muted">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <span>© {year} {SITE.name}</span>
    <a href="/resume.pdf" class="hover:text-fg transition-colors">resume.pdf</a>
    <a href="/llms.txt" class="hover:text-fg transition-colors">llms.txt</a>
    <a href="/blog.rss" class="hover:text-fg transition-colors">rss</a>
    <a href="/feed.json" class="hover:text-fg transition-colors">json</a>
  </div>
  <ThemeToggle />
</footer>
